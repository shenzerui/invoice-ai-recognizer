# ============================================================
# 票据识别管理系统 — .gitignore
# ============================================================

# Node.js / 前端构建
node_modules/
frontend/node_modules/
frontend/dist/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
venv/
.venv/
env/

# PyInstaller 打包产物
backend/build/
backend/dist/

# 后端运行时数据（敏感！）
backend/static/
backend/data/
backend/uploads/
backend/launcher_debug.log
backend/*.log

# 系统临时文件
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*~

# 日志
*.log
bat_out.txt
bat_err.txt

# IDE
.vscode/
.idea/
*.iml
